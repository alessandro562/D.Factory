<!-- ============= 06 · OEE, FERMI E POLMONE — chiara ============= -->
<div class="slide lt" id="d06_oee_fermi" data-kind="dossier">
  <div class="band">
    <div class="band__sec">Sezione 2 · funzioni</div>
    <div class="band__q">Perché macchina ferma non è linea ferma.</div>
    <div class="band__a">Il polmone, o buffer, a valle continua ad alimentare la linea
      finché ha materiale. Se assorbe il fermo, la linea non si ferma e l'OEE di linea non si sconta
      due volte.</div>
    <div class="spacer"></div>
    <div class="open">
      <div class="open__l">Da definire in audit</div>
      <div class="open__i">La formula OEE si calibra sul tuo modo di misurare, prima che i
        numeri finiscano in un report.</div>
    </div>
    <div class="spacer"></div>
    <div class="band__ft"><span class="wm">d<i>.</i>factory</span><span class="pg">06 / 18</span></div>
  </div>

  <div class="field">
    <div class="field__hd"><span>OEE macchina e OEE di linea</span><span>Dati illustrativi</span></div>
    <svg width="864" height="580" viewBox="0 0 864 580" style="margin:26px 40px"
         role="img" aria-labelledby="d6t d6d">
      <title id="d6t">Il polmone assorbe il fermo macchina</title>
      <desc id="d6d">Con il polmone pieno il fermo della macchina non ferma la linea. Con il
        polmone svuotato lo stesso fermo diventa fermo di linea. La differenza fra i due OEE
        e' la capacita' del polmone.</desc>

      <text x="0" y="12" font-family="Geist Mono" font-size="12" fill="rgba(10,10,10,.42)" letter-spacing="1.4">CASO 1 · POLMONE PIENO</text>
      <rect x="0" y="34" width="176" height="60" fill="none" stroke="#0A0A0A" stroke-width="1.6"/>
      <text x="88" y="70" font-family="Geist" font-size="16" fill="#0A0A0A" text-anchor="middle">Macchina ferma</text>
      <path d="M176 64 L232 64" stroke="#0A0A0A" stroke-width="1.6"/>
      <rect x="232" y="34" width="150" height="60" fill="#0A0A0A"/>
      <text x="307" y="70" font-family="Geist" font-size="16" fill="#fff" text-anchor="middle">Polmone pieno</text>
      <path d="M382 64 L438 64" stroke="#0A0A0A" stroke-width="1.6"/>
      <polygon points="438,64 430,59 430,69" fill="#0A0A0A"/>
      <rect x="438" y="34" width="176" height="60" fill="none" stroke="#0A0A0A" stroke-width="1.6"/>
      <text x="526" y="70" font-family="Geist" font-size="16" fill="#0A0A0A" text-anchor="middle">La linea continua</text>

      <text x="0" y="152" font-family="Geist Mono" font-size="12" fill="rgba(10,10,10,.42)" letter-spacing="1.4">CASO 2 · POLMONE SVUOTATO</text>
      <rect x="0" y="174" width="176" height="60" fill="none" stroke="#0A0A0A" stroke-width="1.6"/>
      <text x="88" y="210" font-family="Geist" font-size="16" fill="#0A0A0A" text-anchor="middle">Macchina ferma</text>
      <path d="M176 204 L232 204" stroke="#0A0A0A" stroke-width="1.6"/>
      <rect x="232" y="174" width="150" height="60" fill="none" stroke="rgba(10,10,10,.42)" stroke-width="1.6" stroke-dasharray="5 4"/>
      <text x="307" y="210" font-family="Geist" font-size="16" fill="rgba(10,10,10,.64)" text-anchor="middle">Polmone vuoto</text>
      <path d="M382 204 L438 204" stroke="#E6E011" stroke-width="2.6"/>
      <polygon points="438,204 430,199 430,209" fill="#E6E011"/>
      <rect x="438" y="174" width="176" height="60" fill="#E6E011"/>
      <text x="526" y="210" font-family="Geist" font-size="16" fill="#0A0A0A" text-anchor="middle">La linea si ferma</text>

      <text x="668" y="70" font-family="Geist" font-size="18" fill="#0A0A0A">La differenza</text>
      <text x="668" y="94" font-family="Geist" font-size="18" fill="#0A0A0A">fra i due OEE</text>
      <text x="668" y="118" font-family="Geist" font-size="18" fill="#0A0A0A">è la capacità</text>
      <text x="668" y="142" font-family="Geist" font-size="18" fill="#0A0A0A">del polmone.</text>

      <line x1="0" y1="288" x2="864" y2="288" stroke="rgba(10,10,10,.26)"/>
      <text x="0" y="322" font-family="Geist Mono" font-size="12" fill="rgba(10,10,10,.42)" letter-spacing="1.4">CAUSE DI FERMO · TURNO · ORDINATE PER TEMPO PERSO</text>

      <g font-family="Geist" font-size="16" fill="#0A0A0A">
        <text x="0" y="372">Outfeed</text><text x="0" y="418">Infeed jam</text>
        <text x="0" y="464">Carton mis-feed</text><text x="0" y="510">Glue temp low</text>
        <text x="0" y="556">Vacuum loss</text>
      </g>
      <g fill="rgba(10,10,10,.78)">
        <rect x="180" y="354" width="474" height="22"/><rect x="180" y="400" width="384" height="22"/>
        <rect x="180" y="446" width="258" height="22"/><rect x="180" y="492" width="198" height="22"/>
        <rect x="180" y="538" width="120" height="22"/>
      </g>
      <g font-family="Geist Mono" font-size="13" fill="rgba(10,10,10,.64)">
        <text x="670" y="372">01:19 · 11 ev.</text><text x="580" y="418">01:04 · 8 ev.</text>
